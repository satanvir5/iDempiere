<?xml version="1.0" encoding="UTF-8"?>
<zk>
<style><![CDATA[
@import url("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css");
@import url("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-utilities.min.css");

.login-box-header-logo img { width: 360px; max-width: 100%; height: auto; }
.login-box-header-txt {
    font-size: 0 !important;
}
<!--
.login-box-header-txt:before {
    content: "Welcome to Primitek ERP";
    font-size: 24px;
    font-weight: 700;
    color: #151515;
}
-->
]]></style>
<borderlayout id="layout" sclass="login-window">
	<center border="none" autoscroll="true" style="background-color: transparent;">
		<vbox pack="center" align="center" style="background-color: transparent;" hflex="1" vflex="1">
			<window use="org.adempiere.webui.window.LoginWindow" id="loginWindow"/>
		</vbox>
	</center>
	<east sclass="login-east-panel">
		<include src="~./theme/primitek/zul/login/login-right.zul"/>
	</east>
	 <west sclass="login-west-panel">
	
	<!--	<include src="~./theme/primitek/zul/login/login-left.zul"/> -->
	</west> 
	<north sclass="login-north-panel">
		<include src="~./theme/primitek/zul/login/login-top.zul"/>
	</north>
	<south sclass="login-south-panel">
		<include src="~./theme/primitek/zul/login/login-bottom.zul"/>
	</south>
</borderlayout>
</zk>