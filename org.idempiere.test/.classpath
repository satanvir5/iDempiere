	<classpathentry exported="true" kind="lib" path="lib/objenesis.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/byte-buddy.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/byte-buddy-agent.jar"/>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
